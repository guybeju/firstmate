#!/usr/bin/env bash
# Installed in a board-only root as bin/fm-board.sh, the one program the board
# runs before B4: hands "feed" and "deliver" to the stub $TB_STUB (fm or plain),
# which sits beside it in bin/.
set -euo pipefail
case "${TB_STUB:-}" in
  fm | plain) exec "$(dirname "$0")/stub-$TB_STUB" "$@" ;;
  *) printf 'TB_STUB must be fm or plain\n' >&2; exit 2 ;;
esac
